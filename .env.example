# URL canonique officielle. Vérifier le domaine avant mise en ligne publique.
VITE_SITE_URL=https://avyor.app
VITE_APPLE_APP_URL=
VITE_GOOGLE_PLAY_URL=
# true seulement pour la version publique validée ; previews noindex.
VITE_SITE_INDEXABLE=false
# Mot de passe de l'admin News (développement seulement) : à définir dans
# .env.local, qui n'est ni commité ni déployé. Sans lui, l'admin reste fermée.
AVYOR_ADMIN_PASSWORD=
