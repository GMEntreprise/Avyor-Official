{
  "name": "avyor-official",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src tests scripts/*.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:seo": "node --test tests/seo/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "bun run typecheck && bun run lint && bun run test && bun run build && bun run test:seo && bun run test:e2e",
    "assets:build": "node scripts/build-assets.mjs",
    "webp": "node scripts/webp.mjs",
    "budget": "node scripts/budget.mjs",
    "format": "prettier --write src scripts/*.mjs tests *.ts *.json *.js index.html",
    "format:check": "prettier --check src scripts/*.mjs tests *.ts *.json *.js index.html",
    "measure": "node scripts/measure.mjs",
    "assets:video": "sh scripts/build-video.sh",
    "test:visual:update": "playwright test --grep \"capture\" --update-snapshots"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.34.0",
    "@fontsource-variable/manrope": "^5.2.6",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "cheerio": "^1.1.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.7",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3"
  }
}
