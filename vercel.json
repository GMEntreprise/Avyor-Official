{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/marques/",
      "destination": "/brands/",
      "permanent": true
    },
    {
      "source": "/createurs/",
      "destination": "/creators/",
      "permanent": true
    },
    {
      "source": "/produit/",
      "destination": "/features/",
      "permanent": true
    },
    {
      "source": "/fonctionnalites/",
      "destination": "/features/",
      "permanent": true
    },
    {
      "source": "/comment-ca-marche/",
      "destination": "/how-it-works/",
      "permanent": true
    },
    {
      "source": "/securite/",
      "destination": "/security/",
      "permanent": true
    },
    {
      "source": "/telecharger/",
      "destination": "/download/",
      "permanent": true
    },
    {
      "source": "/confidentialite/",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/cgu/",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/conditions/",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/mentions-legales/",
      "destination": "/legal/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*).webm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
