# Rien de tout cela n'entre dans `bun run build` : autant ne pas l'expédier.
#
# Chaque motif commence par « / » pour viser la racine du projet uniquement.
# Sans lui, la syntaxe gitignore que Vercel applique vise tout dossier du même
# nom à n'importe quelle profondeur : « brand/ » excluait aussi
# public/assets/brand/, et le logo n'a jamais été servi.
/video/
/tools/
/docs/
/brand/
/SEO_BOOSTER/
/tests/
/playwright-report/
/test-results/
/.github/
/.ssr/
# Brouillons News : jamais envoyés, même par un déploiement lancé depuis ce
# poste avec la CLI Vercel (qui lit ce fichier, pas .gitignore).
/content/news-drafts/
# Admin local et bacs à sable de test : rien de tout cela n'est construit.
/admin/
/.news-fixture/
/.news-e2e/
/.news-sandbox/
