                        "text": "20 עד 30 שניות"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "אתם מדברים בטבעיות על מוצר, בלי לקרוא טקסט."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "content": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "אנבוקסינג"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "20 עד 40 שניות"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "אתם מבליטים חפץ ואת האריזה שלו, בלי זמן מת."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "content": [
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "לפני / אחרי או לייפסטייל"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "15 עד 30 שניות"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "אתם מראים תוצאה, או מוצר בתוך סצנה יומיומית אמינה."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "האורכים האלה הם נקודות ייחוס לסדרה ראשונה, לא תקנים: קראו תמיד את ההנחיות של הקמפיין שאליו אתם ניגשים."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "three-lines-of-context"
        },
        "content": [
          {
            "type": "text",
            "text": "שלוש שורות הקשר מתחת לכל סרטון"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "סרטון בלי הקשר משאיר למותג לנחש מה חיפשתם. הוסיפו מתחת לכל אחד:"
          }
        ]
      },
      {
        "type": "orderedList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "המטרה",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ": מה הסרטון היה אמור להבהיר."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "המגבלה",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ": ההנחיה שהצבתם לעצמכם."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "מה הייתם משנים",
                    "marks": [
                      {
                        "type": "bold"
                      }
                    ]
                  },
                  {
                    "type": "text",
                    "text": ": משפט שמראה איך אתם מסתכלים על העבודה שלכם."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "השורה השלישית היא לרוב זו שמותג זוכר: היא מראה שאתם יודעים לקבל משוב."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "what-to-remove"
        },
        "content": [
          {
            "type": "text",
            "text": "מה עדיף להוריד"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "סרטונים שהסאונד שלהם אינו נשמע בלי מוזיקה."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "תכנים בלי מוצר ובלי מסר, מוצלחים ככל שיהיו: הם אינם עונים על אף שאלה של המותג."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "כפילויות: שני אנבוקסינגים דומים אומרים אותו דבר."
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "כל מה שעלול לרמוז על שיתוף פעולה שאינו קיים."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2,
          "id": "before-you-apply"
        },
        "content": [
          {
            "type": "text",
            "text": "לפני הגשת המועמדות"
          }
        ]
      },
      {
        "type": "callout",
        "attrs": {
          "variant": "checklist"
        },
        "content": [
          {
            "type": "bulletList",
            "content": [
              {
